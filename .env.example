# Copy this file to .env for local testing (docker-compose reads it automatically).
# In AWS/Azure, set these as secrets/environment variables on the service instead
# of shipping a .env file inside the image.

# Required: your organization's Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: port the server listens on. Defaults to 8080.
PORT=8080
